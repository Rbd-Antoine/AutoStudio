# Copy to .env for local development; on Vercel, set the same names in
# Project Settings → Environment Variables. Never commit real values.

# ── Database (Postgres) ───────────────────────────────────────────────────────
# Pooled connection string (Neon via the Vercel Marketplace sets it automatically;
# on Supabase use the "Transaction pooler" URL, port 6543).
DATABASE_URL=""

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Random secret: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""
# Public origin of the site, no trailing slash. Optional on Vercel.
NEXTAUTH_URL="http://localhost:3000"
# Required outside Vercel (e.g. `next start` locally or on a VPS); Vercel sets it automatically.
AUTH_TRUST_HOST="true"
# Google sign-in. Redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Accounts with admin access and unlimited credits (comma-separated). Only count once
# the account's email is verified. Defaults to the founders' addresses when unset.
SUPERUSER_EMAILS=""

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
GEMINI_API_KEY=""

# ── File storage (Vercel Blob) ────────────────────────────────────────────────
# Set automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Sender, on a domain verified in Resend. Defaults to "CarGlow <onboarding@resend.dev>",
# which only delivers to the Resend account owner's own address.
EMAIL_FROM=""

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
# Signing secret of the endpoint <origin>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Monthly subscription prices (recurring, EUR)
STRIPE_PRICE_ESSENTIAL=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
# Credit packs (one-time, EUR)
STRIPE_PRICE_PACK_50=""
STRIPE_PRICE_PACK_150=""
STRIPE_PRICE_PACK_400=""

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Required: the /api/cron/* routes refuse every request without it. Vercel Cron sends it.
CRON_SECRET=""

# ── Site identity (optional) ──────────────────────────────────────────────────
# Canonical origin for SEO and email links. Defaults to Vercel's production domain.
NEXT_PUBLIC_SITE_URL=""
# Contact address on legal pages, reply-to of emails, contact form inbox.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Booking page embedded on the landing page (hidden when empty).
NEXT_PUBLIC_CALENDLY_URL=""
# Meta Business domain verification token for the production domain.
FACEBOOK_DOMAIN_VERIFICATION=""

# ── Marketing videos (optional, Shotstack) ────────────────────────────────────
SHOTSTACK_API_KEY=""
# SHOTSTACK_HOST="https://api.shotstack.io/edit/v1"

# ── Analytics and ads (optional, no-op when empty) ────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
